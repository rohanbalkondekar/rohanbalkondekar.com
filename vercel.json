{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.rohanbalkondekar.com" }],
      "destination": "https://rohanbalkondekar.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/workout",
      "destination": "https://rohan-workout-guide.outsightai.chatgpt.site/workout"
    },
    {
      "source": "/workout/:path*",
      "destination": "https://rohan-workout-guide.outsightai.chatgpt.site/workout/:path*"
    },
    { "source": "/llms-full.txt", "destination": "/index.md" }
  ]
}
