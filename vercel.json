{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/workout/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.rohanbalkondekar.com" }],
      "destination": "https://rohanbalkondekar.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/workout",
      "destination": "/workout/index.html"
    },
    {
      "source": "/workout/api/:path*",
      "destination": "https://rohan-workout-guide.outsightai.chatgpt.site/workout/api/:path*"
    },
    { "source": "/llms-full.txt", "destination": "/index.md" }
  ]
}
